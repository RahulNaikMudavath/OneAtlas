generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  type        String?
  models      Model[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Model {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  category      String
  contextWindow String
  inputPrice    Float
  outputPrice   Float
  description   String?
  capabilities  String[]
  modalities    String[]
  releaseDate         DateTime?
  source              String?
  sourceModelId       String?
  sourceCreatedAt     DateTime?
  supportedParameters String[] @default([])
  lastSyncedAt        DateTime?

  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])

  providers     ModelProvider[]
  benchmarks    Benchmark[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Provider {
  id          String   @id @default(cuid())
  name        String   @unique
  website     String?
  models      ModelProvider[]
  createdAt   DateTime @default(now())
}

model ModelProvider {
  id         String   @id @default(cuid())
  modelId    String
  providerId String

  // Provider-specific pricing per 1 million tokens (USD)
  inputPricePerMillion  Float?
  outputPricePerMillion Float?

  // Provider performance information
  latencyMs      Float?
  uptimePercent  Float?
  isAvailable    Boolean  @default(true)
  lastCheckedAt  DateTime?

  endpointTag         String   @default("default")
  endpointName        String?
  serviceTier         String?
  maxPromptTokens     Int?
  maxCompletionTokens Int?
  uptimeLast30m       Float?

  model      Model    @relation(fields: [modelId], references: [id])
  provider   Provider @relation(fields: [providerId], references: [id])

  @@unique([modelId, providerId, endpointTag])
  @@index([providerId])
  @@index([modelId])
}

model Benchmark {
  id          String   @id @default(cuid())
  name        String
  category    String
  score       Float
  source      String?
  evaluatedAt DateTime?

  modelId     String
  model       Model    @relation(fields: [modelId], references: [id])

  createdAt   DateTime @default(now())
}
